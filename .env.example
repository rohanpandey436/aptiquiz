# Port the server listens on. Render sets PORT automatically.
PORT=3000
# Where runtime data (question sets, finished games) is written.
DATA_DIR=./data
# Socket events allowed per second per connection (abuse protection).
RATE_LIMIT_PER_SEC=20
# Optional. When set, the question editor (and any API call that reveals answers) requires this passcode.
# Leave empty for an open editor; hosting a game never needs a passcode.
HOST_PASSCODE=
# Optional. A URL the server fetches every 10 minutes to keep a free hosting instance awake.
# On Render this is derived from RENDER_EXTERNAL_URL automatically.
KEEPALIVE_URL=
